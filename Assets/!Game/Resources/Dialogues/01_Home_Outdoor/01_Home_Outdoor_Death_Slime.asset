  m_Script: {fileID: 11500000, guid: 59b366e6022b8614985e2aa3d435fb24, type: 3}
  m_Name: 01_Home_Outdoor_Death_Slime
  m_EditorClassIdentifier: Assembly-CSharp::MonologueData
  typingSpeed: 0.05
  autoProgressDelay: 1.5
  dialogueLines:
  - "M\xF9i g\xEC kinh kh\u1EE7ng th\u1EBF n\xE0y? Slime... sao l\u1EA1i c\xF3 m\xE0u
    n\xE0y? L\u1EA1i c\xF2n to th\u1EBF n\xE0y n\u1EEFa?"
  - "D\u1EA5u v\u1EBFt n\xE0y... Kh\xF4ng ph\u1EA3i do th\xFA r\u1EEBng c\u1EAFn
    x\xE9. C\xF3 th\u1EE9 g\xEC \u0111\xF3... kh\u1EE7ng khi\u1EBFp \u1EDF s\xE2u
    trong khu r\u1EEBng kia."
  - "N\u01B0\u1EDBc t\u1EEB th\u01B0\u1EE3ng ngu\u1ED3n \u0111ang b\u1ECB \xF4 nhi\u1EC5m.
    C\u1EE9 \u0111\xE0 n\xE0y, ngu\u1ED3n n\u01B0\u1EDBc c\u1EE7a nh\xE0 m\xECnh
    c\u0169ng ti\xEAu t\xF9ng m\u1EA5t."
  - "M\u1EB9 l\xFAc n\xE0o c\u0169ng c\u1EA5m m\xECnh b\xE9n m\u1EA3ng t\u1EDBi \u0111\xF3.
    Nh\u01B0ng n\u1EBFu m\xECnh kh\xF4ng ki\u1EC3m tra xem c\xE1i g\xEC \u0111ang
    r\xF2 r\u1EC9 ra th\u1EE9 ch\u1EA5t \u0111\u1ED9c n\xE0y, th\xEC s\u1EDBm mu\u1ED9n
    khu v\u01B0\u1EDDn c\u1EE7a m\u1EB9 c\u0169ng ch\u1EBFt r\u1EE5i."
  - "Ch\u1EC9 v\xE0o ng\xF3 m\u1ED9t ch\xFAt th\xF4i. Xem c\xF3 chuy\u1EC7n qu\xE1i
    g\xEC \u0111ang x\u1EA3y ra."
  - "Nh\u01B0ng v\xE1c c\xE1i c\u1EA7n c\xE2u n\xE0y v\xE0o \u0111\xF3 th\xEC kh\xE1c
    g\xEC \u0111i n\u1ED9p m\u1EA1ng. M\xECnh c\u1EA7n m\u1ED9t th\u1EE9 s\u1EAFc
    b\xE9n h\u01A1n."
  autoProgressLines: 010101010101
  endDialogueLines: 000000000001
