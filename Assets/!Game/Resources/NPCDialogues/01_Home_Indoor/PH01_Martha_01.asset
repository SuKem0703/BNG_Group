  m_Script: {fileID: 11500000, guid: 7f2a72aeb33766d42868f6d9de333142, type: 3}
  m_Name: PH01_Martha_01
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  typingSpeed: 0.05
  autoProgressDelay: 1.5
  dialogueLines:
  - "Gi\u1EDD n\xE0y m\u1EDBi v\xE1c m\u1EB7t ra c\u01A1 \u0111\u1EA5y! \u0110\u1EE3i
    con d\u1EADy ch\u1EAFc c\u1ECF ngo\xE0i ru\u1ED9ng m\u1ECDc cao b\u1EB1ng \u0111\u1EA7u
    ng\u01B0\u1EDDi r\u1ED3i."
  - "S\xE1ng s\u1EDBm g\xEC n\u1EEFa! N\u1EAFng ch\xE1y c\u1EA3 ng\u1ECDn cau r\u1ED3i
    k\xECa. Nhanh c\xE1i ch\xE2n l\xEAn, \u0111\u1ED3ng \xE1ng kh\xF4ng t\u1EF1 n\xF3
    l\xE0m \u0111\u01B0\u1EE3c \u0111\xE2u."
  - 
  - 
  - "Tuy\u1EC7t \u0111\u1ED1i kh\xF4ng! M\u1EB9 \u0111\xE3 n\xF3i bao nhi\xEAu l\u1EA7n
    r\u1ED3i Elric? Ch\u1ED7 \u0111\xF3 kh\xF4ng ph\u1EA3i ch\u1ED7 \u0111\u1EC3
    con l\xEAn ch\u01A1i \u0111\xF9a! B\u1ECF ngay c\xE1i suy ngh\u0129 \u0111i\xEAn
    r\u1ED3 \u0111\xF3 \u0111i!"
  - 
  - "\u0110\u1EEBng mang t\xEDnh m\u1EA1ng m\xECnh ra \u0111\xF9a gi\u1EE1n, Elric.
    Th\xF4i... v\xE0o nh\xE0 \u0103n s\xE1ng \u0111i, m\u1EB9 c\xF3 ch\u1EEBa ph\u1EA7n
    \u0111\u0129a c\xE0 ri tr\xEAn b\xE0n \u0111\u1EA5y. \u0102n xong r\u1ED3i ra
    \u0111\xE2y m\u1EB9 nh\u1EDD ch\xFAt vi\u1EC7c."
  autoProgressLines: 01010101010101
  endDialogueLines: 00000000000001
  quest: {fileID: 11400000, guid: f5fadfdcab57bab419cce3eb929cf1c4, type: 2}
  questInProgressIndex: -1
  questCompletedIndex: 0
  noMoreQuestsIndex: -1
  npcName: Martha
  npcPortrait: {fileID: -875880131977736440, guid: 66cc4a7b23c823245a5698a4c18f26bf, type: 3}
  choices:
  - dialogueIndex: 0
    choices:
    - "Con ra r\u1ED3i \u0111\xE2y m\u1EB9... M\u1EDBi s\xE1ng s\u1EDBm m\xE0\u2026"
    nextDialogueIndexes: 01000000
    endDialogues: 
    specialActions: 
    specialTargetNames: []
    giveQuest: 
  - dialogueIndex: 1
    choices:
    - "V\xE2ng v\xE2ng... L\u1EA1i nh\u1ED5 c\u1ECF, t\u01B0\u1EDBi c\xE2y, r\u1ED3i
      l\u1EA1i \u0111i l\xF9a m\u1EA5y con Slime r\xE1ch ngo\xE0i ru\u1ED9ng."
    nextDialogueIndexes: 02000000
    endDialogues: 
    specialActions: 
    specialTargetNames: []
    giveQuest: 
  - dialogueIndex: 2
    choices:
    - ...
    nextDialogueIndexes: 03000000
    endDialogues: 
    specialActions: 
    specialTargetNames: []
    giveQuest: 
  - dialogueIndex: 3
    choices:
    - "Hay l\xE0... m\u1EB9 cho con l\xEAn m\u1EA1n r\u1EEBng ph\xEDa T\xE2y B\u1EAFc
      s\u0103n th\u1EED \u0111i? D\u1EA1o g\u1EA7n \u0111\xE2y, \u0111\xEAm n\xE0o
      con c\u0169ng th\u1EA5y b\u1EA7u tr\u1EDDi h\u01B0\u1EDBng \u0111\xF3 \u0111\u1ED5i
      m\xE0u k\u1EF3 l\u1EA1 l\u1EAFm, th\u1EC9nh tho\u1EA3ng c\xF2n c\xF3 ti\u1EBFng
      g\u1EA7m\u2014"
    nextDialogueIndexes: 04000000
    endDialogues: 
    specialActions: 
    specialTargetNames: []
    giveQuest: 
  - dialogueIndex: 4
    choices:
    - "Con... con ch\u1EC9 n\xF3i \u0111\xF9a th\xF4i m\xE0. M\u1EB9 l\xE0m g\xEC
      m\xE0 c\u0103ng th\u1EBF\u2026"
    nextDialogueIndexes: 05000000
    endDialogues: 
    specialActions: 
    specialTargetNames: []
    giveQuest: 
  - dialogueIndex: 5
    choices:
    - "(L\u1EA1i n\u1EEFa... L\u1EA7n n\xE0o nh\u1EAFc \u0111\u1EBFn khu r\u1EEBng
      \u0111\xF3 m\u1EB9 c\u0169ng n\u1ED5i c\xE1u. R\u1ED1t cu\u1ED9c tr\xEAn \u0111\xF3
      c\xF3 c\xE1i qu\xE1i g\xEC m\xE0 m\u1EB9 s\u1EE3 th\u1EBF nh\u1EC9?)"
    nextDialogueIndexes: 06000000
    endDialogues: 
