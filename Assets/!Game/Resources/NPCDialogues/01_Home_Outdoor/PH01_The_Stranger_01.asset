  m_Script: {fileID: 11500000, guid: 7f2a72aeb33766d42868f6d9de333142, type: 3}
  m_Name: PH01_The_Stranger_01
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogueData
  typingSpeed: 0.05
  autoProgressDelay: 1.5
  dialogueLines:
  - 
  - "Kh\xF4ng... v\xF4 \xEDch th\xF4i..."
  - "L\xE0... ng\u01B0\u01A1i... L\u1EA7n n\xE0y... ta \u0111\xE3 v\u1EC1 k\u1ECBp
    l\xFAc sao...?"
  - "Nghe cho r\xF5 \u0111\xE2y... Ng\xF4i \u0111\u1EC1n \u0111\xE1... h\u01B0\u1EDBng
    T\xE2y B\u1EAFc... Phong \u1EA5n \u0111ang n\u1EE9t v\u1EE1... B\u1ECDn ch\xFAng
    \u0111ang khao kh\xE1t C\u1ED5 Ng\u1EEF..."
  - "N\u1EBFu C\u1ED5 Ng\u1EEF r\u01A1i v\xE0o tay k\u1EBB \u0111\xF3... th\u1EA3m
    k\u1ECBch s\u1EBD l\u1EB7p l\u1EA1i... M\u1ECDi th\u1EE9 ng\u01B0\u01A1i y\xEAu
    th\u01B0\u01A1ng... \u0111\u1EC1u s\u1EBD h\xF3a th\xE0nh tro b\u1EE5i..."
  - "\u0110\u1EEBng \u0111\u1EC3 v\xF2ng l\u1EB7p n\xE0y... ti\u1EBFp di\u1EC5n.
    \u0110i \u0111i... L\u1EA5y n\xF3 tr\u01B0\u1EDBc khi 'h\u1EAFn' \u0111\u1EBFn...
    \u0110\u1EEBng l\u1EB7p l\u1EA1i... sai l\u1EA7m c\u1EE7a ta..."
  autoProgressLines: 010101010101
  endDialogueLines: 000000000001
  quest: {fileID: 11400000, guid: 288a6fb92227373478d707e72b16d878, type: 2}
