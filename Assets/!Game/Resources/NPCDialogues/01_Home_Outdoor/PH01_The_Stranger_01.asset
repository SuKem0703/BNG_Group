  choices:
  - dialogueIndex: 0
    choices:
    - "N\xE0y anh! Anh b\u1ECB sao v\u1EADy? V\u1EBFt th\u01B0\u01A1ng n\xE0y...
      \u0111\u1EC3 t\xF4i ch\u1EA1y v\u1EC1 g\u1ECDi m\u1EB9, m\u1EB9 t\xF4i l\xE0
      D\u01B0\u1EE3c s\u01B0\u2014"
    nextDialogueIndexes: 01000000
    endDialogues: 
    specialActions: 
    specialTargetNames: []
    giveQuest: 
  - dialogueIndex: 1
    choices:
    - "Anh m\u1EA5t nhi\u1EC1u m\xE1u qu\xE1 r\u1ED3i!"
    nextDialogueIndexes: 02000000
    endDialogues: 
    specialActions: 
    specialTargetNames: []
    giveQuest: 
  - dialogueIndex: 2
    choices:
    - "Anh n\xF3i g\xEC c\u01A1? Anh bi\u1EBFt t\xF4i?"
    nextDialogueIndexes: 03000000
    endDialogues: 
    specialActions: 
    specialTargetNames: []
    giveQuest: 
  - dialogueIndex: 4
    choices:
    - "\u0110\u1EC1n \u0111\xE1? C\u1ED5 Ng\u1EEF? Ch\xFA \u0111ang n\xF3i s\u1EA3ng
      c\xE1i g\xEC v\u1EADy?!"
