  m_Script: {fileID: 11500000, guid: 7f2a72aeb33766d42868f6d9de333142, type: 3}
  m_Name: PH01_Martha_03
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogueData
  typingSpeed: 0.05
  autoProgressDelay: 1.5
  dialogueLines:
  - "\xC0, tr\u01B0a nay nh\xE0 m\xECnh h\u1EBFt th\u1EE9c \u0103n m\u1EB7n r\u1ED3i.
    S\u1EB5n ch\xE2n \u0111ang r\u1EA3nh, x\xE1ch c\u1EA7n ra \u0111o\u1EA1n su\u1ED1i
    ngo\xE0i r\xECa r\u1EEBng ph\xEDa B\u1EAFc ki\u1EBFm v\xE0i con c\xE1 v\u1EC1
    n\u1EA5u canh \u0111i."
  - "Nh\u1EDB k\u1EF9: Ch\u1EC9 \u0111\u01B0\u1EE3c ng\u1ED3i \u1EDF \u0111o\u1EA1n
    n\u01B0\u1EDBc c\u1EA1n m\xE0 c\xE2u. Tuy\u1EC7t \u0111\u1ED1i kh\xF4ng \u0111\u01B0\u1EE3c
    t\xF2 m\xF2 m\xE0 \u0111i ng\u01B0\u1EE3c l\xEAn th\u01B0\u1EE3ng ngu\u1ED3n
    hay l\u1EE7i v\xE0o r\u1EEBng, nghe r\xF5 ch\u01B0a?"
  - "\u0110i \u0111i, \u0111\u1EEBng c\xF3 l\u01B0\u1EE3n l\u1EDD c\u1EA3n tr\u1EDF
    m\u1EB9 l\xE0m vi\u1EC7c n\u1EEFa."
  autoProgressLines: 010101
  endDialogueLines: 000101
  quest: {fileID: 11400000, guid: 288a6fb92227373478d707e72b16d878, type: 2}
  questInProgressIndex: 2
