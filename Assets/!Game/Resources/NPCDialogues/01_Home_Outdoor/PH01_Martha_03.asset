  npcName: Martha
  npcPortrait: {fileID: -875880131977736440, guid: 66cc4a7b23c823245a5698a4c18f26bf, type: 3}
  choices:
  - dialogueIndex: 1
    choices:
    - "V\xE2ng v\xE2ng, th\u01B0a b\xE0 s\u1EBFp. Ch\u1EC9 c\xE2u \u1EDF m\xE9p su\u1ED1i
      th\xF4i. \u1EDE nh\xE0 chu\u1EA9n b\u1ECB r\u1ED5 \u0111i, \u0111\u1EC3 xem
      h\xF4m nay con s\xE1t c\xE1 c\u1EE1 n\xE0o."
